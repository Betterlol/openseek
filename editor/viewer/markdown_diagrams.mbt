///|
/// Compile PlantUML-style diagram source to an SVG that follows the Viewer's
/// host color variables. Invalid or unsupported source returns `None`.
///
/// The returned string is generated by the pinned UML renderer, not copied
/// from the source, and is suitable for a trusted SVG insertion boundary.
pub fn render_uml_diagram_svg(source : String) -> String? {
  @markdown_core.render_uml_diagram_svg(source)
}

///|
/// Compile a generated `.mbti` interface body to a theme-aware SVG. Invalid
/// or unsupported interface source returns `None` so hosts can keep a source
/// fallback available.
pub fn render_mbti_diagram_svg(source : String) -> String? {
  @markdown_core.render_mbti_diagram_svg(source)
}

///|
/// Compile the JSON emitted by `moon tree --package --json` to a theme-aware
/// package dependency SVG. Invalid graph JSON returns `None` so hosts can keep
/// the manifest source available as a fallback.
pub fn render_package_dep_diagram_svg(source : String) -> String? {
  @markdown_core.render_package_dep_diagram_svg(source)
}
